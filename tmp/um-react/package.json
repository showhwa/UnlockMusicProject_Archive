{
  "name": "um-react",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -p tsconfig.prod.json && vite build && pnpm build:finalize",
    "build:finalize": "node scripts/write-version.mjs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier -w .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "preview:coverage": "vite preview --outDir coverage --port 5175",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@unlock-music/crypto": "^0.1.12",
    "classnames": "^2.5.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "nanoid": "^6.0.2",
    "radash": "^12.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.5.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-toastify": "^11.1.0",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.11",
    "@types/tar-stream": "^3.1.5",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "sass": "^1.105.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tar-stream": "^3.2.2",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,jsx,ts,tsx}": "eslint --fix --report-unused-disable-directives --max-warnings 0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm test"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
